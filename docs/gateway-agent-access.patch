+import { describe, it, expect } from "vitest";
+import app from "../src/index";
+import {
+  sha256,
+  verifyAgentSignature,
+  parseAgentClaims,
+  type AgentClaims,
+} from "../src/places-agent-contract";
+const token = "qp_" + "a".repeat(43),
+  secret = "test-internal-secret";
+const claims: AgentClaims = {
+  tokenId: "agent-test",
+  identity: "mhinz.mh22@gmail.com",
+  scopes: ["places:read", "places:lookup", "places:create"],
+};
+async function setup(overrides = {}) {
+  const captured: Request[] = [];
+  const env = {
+    PLACES_AGENT_TOKENS: JSON.stringify([
+      {
+        ...claims,
+        hash: await sha256(token),
+        expiresAt: "2099-01-01",
+        disabled: false,
+        ...overrides,
+      },
+    ]),
+    QUOLLITY_INTERNAL_SECRET: secret,
+    EDITOR_EMAILS: claims.identity,
+    SESSION_SIGNING_SECRET: "test-cookie-secret",
+    PLACES: {
+      fetch: async (request: Request) => {
+        captured.push(request);
+        const actor = parseAgentClaims(
+          JSON.parse(request.headers.get("X-Quollity-Agent")!),
+        )!;
+        expect(
+          await verifyAgentSignature(
+            secret,
+            request,
+            actor,
+            request.headers.get("X-Quollity-Timestamp")!,
+            request.headers.get("X-Quollity-Signature")!,
+            await sha256(await request.clone().text()),
+          ),
+        ).toBe(true);
+        return Response.json({ ok: true });
+      },
+    },
+  };
+  return { env, captured };
+}
+async function request(
+  env: Record<string, unknown>,
+  path = "/places/api/places",
+  authorization = `Bearer ${token}`,
+  body?: unknown,
+  extra: Record<string, string> = {},
+) {
+  return app.request(
+    new Request("https://quollity.uk" + path, {
+      method: body ? "POST" : "GET",
+      headers: {
+        Authorization: authorization,
+        ...(body
+          ? {
+              "Content-Type": "application/json",
+              "Idempotency-Key": "test-intent",
+            }
+          : {}),
+        ...extra,
+      },
+      body: body ? JSON.stringify(body) : undefined,
+    }),
+    undefined,
+    env,
+  );
+}
+describe("Places agent gateway", () => {
+  it("authenticates tokens, strips external credentials and forged delegation, and signs body/query/key/owner/scopes", async () => {
+    const { env, captured } = await setup();
+    expect(
+      (
+        await request(
+          env,
+          "/places/api/places?country=GB",
+          `Bearer ${token}`,
+          { name: "Test", placeTypeId: "other" },
+          {
+            Cookie: "old-cookie",
+            "X-Quollity-Agent": "forged",
+            "X-Quollity-Role": "viewer",
+            "X-Quollity-Identity": "wrong@example.com",
+            "X-Quollity-Other": "untrusted",
+          },
+        )
+      ).status,
+    ).toBe(200);
+    const forwarded = captured[0];
+    expect(new URL(forwarded.url).pathname).toBe("/api/places");
+    expect(new URL(forwarded.url).search).toBe("?country=GB");
+    expect(forwarded.headers.get("Authorization")).toBeNull();
+    expect(forwarded.headers.get("Cookie")).toBeNull();
+    expect(forwarded.headers.get("X-Quollity-Other")).toBeNull();
+    expect(forwarded.headers.get("X-Quollity-Identity")).toBe(claims.identity);
+    expect(forwarded.headers.get("X-Quollity-Role")).toBeNull();
+  });
+  it("rejects expired, disabled, malformed, and absent credentials without forwarding", async () => {
+    for (const override of [
+      { expiresAt: "2000-01-01" },
+      { disabled: true },
+      { identity: "not-editor@example.com" },
+    ]) {
+      const { env, captured } = await setup(override);
+      expect((await request(env)).status).toBeGreaterThanOrEqual(400);
+      expect(captured).toHaveLength(0);
+    }
+    const { env, captured } = await setup();
+    expect((await request(env, undefined, "Bearer wrong")).status).toBe(401);
+    expect(captured).toHaveLength(0);
+  });
+  it("blocks scope and cross-component access and rejects oversized bodies", async () => {
+    const { env, captured } = await setup({ scopes: ["places:read"] });
+    expect(
+      (await request(env, undefined, undefined, { name: "No" })).status,
+    ).toBe(403);
+    for (const path of [
+      "/zoos/api/places",
+      "/trips/api/trips",
+      "/snaps/photos/test",
+      "/api/session",
+      "/places/",
+      "/places/api/boards",
+    ])
+      expect((await request(env, path)).status).toBe(403);
+    expect(captured).toHaveLength(0);
+    const allowed = await setup();
+    expect(
+      (
+        await request(allowed.env, undefined, undefined, {
+          notes: "x".repeat(131073),
+        })
+      ).status,
+    ).toBe(413);
+    expect(allowed.captured).toHaveLength(0);
+  });
+});
