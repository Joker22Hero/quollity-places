{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quollity-places",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "AUTH_MODE": "local",
    "LOCAL_IDENTITY": "michael",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quollity-places-db",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "quollity-places",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "AUTH_MODE": "gateway",
        "LOCAL_IDENTITY": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "quollity-places-db",
          "migrations_dir": "migrations",
        },
      ],
      "services": [
        {
          "binding": "TRIPS",
          "service": "travel-visual",
        },
      ],
    },
  },
}
